{
  "name": "linkflow",
  "productName": "外链助手",
  "version": "1.2.11",
  "description": "个人免费外链计划客户端",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "package:mac": "npm run build && node scripts/package.mjs mac-arm64",
    "package:win": "npm run build && node scripts/package.mjs windows-x64",
    "test:integration": "node scripts/audit-integration-run.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "privacy:source": "node scripts/privacy-scan.mjs source",
    "privacy:dist": "node scripts/privacy-scan.mjs dist",
    "privacy:release": "node scripts/privacy-release.mjs",
    "test:update-ui": "node scripts/update-ui-smoke.cjs",
    "test:site-review-ui": "node scripts/site-review-ui-smoke.cjs",
    "update:sign": "node scripts/sign-update.mjs",
    "test:update-native": "node scripts/update-native-smoke.mjs",
    "test:account-ui": "node scripts/account-ui-smoke.cjs",
    "test:planning-ui": "node scripts/planning-ui-smoke.cjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cheerio": "^1.1.2",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
